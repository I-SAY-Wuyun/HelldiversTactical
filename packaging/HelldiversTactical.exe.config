<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup useLegacyV2RuntimeActivationPolicy="true">
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
  </startup>
  <runtime>
    <!-- pythonnet loads Python.Runtime.dll via Assembly.LoadFile.  On some
         machines a secondary volume is classified as a remote location, which
         .NET blocks by default.  This app is fully local, so allow it. -->
    <loadFromRemoteSources enabled="true" />
  </runtime>
</configuration>
